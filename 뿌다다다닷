    }).catch(function (error) {
      render();
      showFlash((error && error.message) || '경기상태를 바꾸지 못했습니다. 다시 시도해 주세요.', false);
    }).then(function () {
      setStatusButtonsDisabled(false);
    });
  }

  function empty(title, detail) {
    var box = el('div', 'empty');
    box.appendChild(el('strong', '', title));
    box.appendChild(document.createTextNode(detail));
    return box;
  }

  function updateScoreboard() {
    var open = games.filter(function (g) { return g.status === '매칭중'; });
    var regions = {};
    open.forEach(function (g) { if (g.region) regions[g.region] = true; });
    $('sb-open').textContent = pad(open.length);
    $('sb-done').textContent = pad(games.length - open.length);
    $('sb-regions').textContent = pad(Object.keys(regions).length);
  }

  function renderStrip(f) {
    var box = $('date-strip');
    var scroll = box.scrollLeft;
    box.textContent = '';
    var others = games.filter(function (g) { return matches(g, Object.assign({}, f, { date: '' })); });

    var all = el('button', 'day-btn all', '전체');
    all.type = 'button';
    all.setAttribute('aria-pressed', String(!f.date));
    all.addEventListener('click', function () { $('f-date').value = ''; render(); });
    box.appendChild(all);

    var now = new Date();
    for (var i = 0; i < 28; i++) {
      (function (offset) {
        var day = new Date(now.getFullYear(), now.getMonth(), now.getDate() + offset);
        var text = day.getFullYear() + '-' + pad(day.getMonth() + 1) + '-' + pad(day.getDate());
        var count = others.filter(function (g) { return g.date === text; }).length;
        var weekend = day.getDay() === 0 || day.getDay() === 6;
        var button = el('button', 'day-btn' + (weekend ? ' weekend' : '') + (count ? '' : ' none'));
        button.type = 'button';
        button.setAttribute('aria-pressed', String(f.date === text));
        button.setAttribute('aria-label', (day.getMonth() + 1) + '월 ' + day.getDate() + '일 경기 ' + count + '건');
        button.appendChild(el('span', 'day-week', offset === 0 ? '오늘' : WEEKDAYS[day.getDay()]));
        button.appendChild(el('span', 'day-num', pad(day.getDate())));
        button.appendChild(el('span', 'day-count', count ? count + '경기' : '-'));
        button.addEventListener('click', function () {
          $('f-date').value = f.date === text ? '' : text;
          render();
        });
        box.appendChild(button);
      })(i);
    }
    box.scrollLeft = scroll;
  }

  function render() {
    if (loaded) updateScoreboard();
    var box = $('results');
    box.textContent = '';
    if (loadError) {
      $('count').textContent = '경기를 불러오지 못했습니다';
      box.appendChild(empty('시트를 읽지 못했습니다', loadError));
      return;
    }
    if (!loaded) return;

    var f = filterValues();
    var today = todayText();
    renderStrip(f);
    var shown = sortGames(games.filter(function (g) { return matches(g, f); }), today);
    $('count').textContent = (f.status || '전체') + ' 경기 ' + shown.length + '건';

    if (f.from && f.to && f.from > f.to) {
      box.appendChild(empty('시간 조건을 확인해 주세요', '\'부터\' 시각이 \'까지\' 시각보다 늦습니다.'));
      return;
    }
    if (!shown.length) {
      box.appendChild(games.length
        ? empty('조건에 맞는 경기가 없습니다', '조건을 바꾸거나 지워 보세요.')
        : empty('아직 경기가 없습니다', '입력 화면에서 첫 경기를 저장해 보세요.'));
      return;
    }

    var list = el('ul', 'games');
    shown.forEach(function (g, index) { list.appendChild(gameCard(g, today, index === 0 && g.date >= today && g.status === '매칭중')); });
    box.appendChild(list);
  }

  function setAdmin(code, alias) {
    adminCode = code;
    $('admin-who').textContent = code ? '관리자 ' + alias + ' 접속 중' : '';
    if (!code) games.forEach(function (g) { g.mine = false; });
    $('gate').hidden = !!code;
    $('form').hidden = !code;
    $('admin-bar').hidden = !code;
    $('admin-open').hidden = !!code;
    undoChange = null;
    showFlash('', false);
    render();
  }

  function showTab(name) {
    var isList = name === 'list';
    $('view-list').hidden = !isList;
    $('view-add').hidden = isList;
    $('tab-list').setAttribute('aria-selected', String(isList));
    $('tab-add').setAttribute('aria-selected', String(!isList));
  }

  function clearFilters(status) {
    $('f-date').value = '';
    $('f-region').value = '';
    $('f-from').value = '';
    $('f-to').value = '';
    var target = document.querySelector('input[name="f-status"][value="' + status + '"]');
    if (target) target.checked = true;
  }

  function readForm() {
    var data = new FormData($('form'));
    var game = {};
    ['date', 'start', 'end', 'region', 'place', 'level', 'age', 'players', 'sport', 'format', 'fee', 'share', 'comment'].forEach(function (key) {
      game[key] = String(data.get(key) || '').trim();
    });
    game.status = '매칭중';
    game.fee = game.fee.replace(/\D/g, '');
    return game;
  }

  function placeKey(place) {
    return String(place).replace(/\s+/g, '').toLowerCase();
  }

  function placeConflict(g) {
    if (!g.place || !g.region) return '';
    var key = placeKey(g.place);
    var other = games.filter(function (item) {
      return item.region && item.region !== g.region && placeKey(item.place) === key;
    })[0];
    return other
      ? '\'' + other.place + '\'은(는) 이미 ' + other.region + ' 구장으로 저장되어 있습니다. 지역을 ' + other.region + '(으)로 고르거나, 다른 구장이면 이름을 구분해 적어 주세요.'
      : '';
  }

  // 고른 지역에 이미 저장된 구장을 장소 칸의 추천 목록으로 보여 줍니다.
  function updatePlaceList() {
    var region = $('region').value;
    var seen = {};
    var list = $('place-list');
    list.textContent = '';
    games.forEach(function (g) {
      if (!g.place || seen[g.place] || (region && g.region !== region)) return;
      seen[g.place] = true;
      var option = document.createElement('option');
      option.value = g.place;
      list.appendChild(option);
    });
  }

  function fillRegions(select) {
    REGION_GROUPS.forEach(function (group) {
      var box = document.createElement('optgroup');
      box.label = group[0];
      group[1].forEach(function (name) {
        var option = el('option', '', name);
        option.value = name;
        box.appendChild(option);
      });
      select.appendChild(box);
    });
  }

  function checkForm(g) {
    if (!g.date) return '날짜를 입력해 주세요.';
    if (!g.start) return '시작시각을 입력해 주세요.';
    if (!g.end) return '끝시각을 입력해 주세요.';
    if (g.end <= g.start) return '끝시각은 시작시각보다 늦어야 합니다.';
    if (/0\d{1,2}[-.\s]?\d{3,4}[-.\s]?\d{4}/.test(g.place)) return '장소에 전화번호는 넣을 수 없습니다. 구장 이름만 입력해 주세요.';
    if ([g.format, g.share, g.comment].some(function (text) { return /0\d{1,2}[-.\s]?\d{3,4}[-.\s]?\d{4}/.test(text); })) {
      return '전화번호는 넣을 수 없습니다. 연락은 댓글과 채팅으로 받아 주세요.';
    }
    return placeConflict(g);
  }

  function showFormError(message) {
    $('form-error').textContent = message;
    $('form-error').hidden = !message;
  }

  $('form').addEventListener('submit', function (event) {
    event.preventDefault();
    var game = readForm();
    var problem = checkForm(game);
    showFormError(problem);
    if (problem) return;

    $('save').disabled = true;
    $('save').textContent = '올리는 중';
    call('addGame', Object.assign({ adminCode: adminCode }, game)).then(function (rows) {
      games = rows;
      loaded = true;
      newKey = keyOf(game);
      $('form').reset();
      showFlash('', false);
      updatePlaceList();
      clearFilters(game.status);
      showTab('list');
      render();
      $('count').textContent = '저장했습니다. ' + $('count').textContent;
      var added = document.querySelector('.game.new');
      if (added) added.scrollIntoView({ block: 'center' });
    }).catch(function (error) {
      showFormError((error && error.message) || '저장하지 못했습니다. 다시 시도해 주세요.');
    }).then(function () {
      $('save').disabled = false;
      $('save').textContent = '경기 올리기';
    });
  });

  ['f-date', 'f-region', 'f-from', 'f-to'].forEach(function (id) { $(id).addEventListener('input', render); });
  document.querySelectorAll('input[name="f-status"]').forEach(function (input) {
    input.addEventListener('change', render);
  });
  $('gate').addEventListener('submit', function (event) {
    event.preventDefault();
    var code = $('admin-code').value.trim();
    $('gate-error').hidden = true;
    if (!code) {
      $('gate-error').textContent = '관리자 코드를 입력해 주세요.';
      $('gate-error').hidden = false;
      return;
    }
    $('gate-submit').disabled = true;
    call('verifyAdmin', code).then(function (result) {
      $('admin-code').value = '';
      games = result.games;
      loaded = true;
      updatePlaceList();
      setAdmin(code, result.alias);
    }).catch(function (error) {
      $('gate-error').textContent = (error && error.message) || '코드를 확인하지 못했습니다. 다시 시도해 주세요.';
      $('gate-error').hidden = false;
    }).then(function () {
      $('gate-submit').disabled = false;
    });
  });
  $('admin-open').addEventListener('click', function () {
    showTab('add');
    $('admin-code').focus();
  });
  $('admin-end').addEventListener('click', function () {
    $('form').reset();
    showFormError('');
    setAdmin('', '');
  });
  $('undo').addEventListener('click', function () {
    if (!undoChange) return;
    var target = undoChange;
    setStatusButtonsDisabled(true);
    call('setGameStatus', Object.assign({ adminCode: adminCode }, target)).then(function (rows) {
      games = rows;
      undoChange = null;
      render();
      showFlash('되돌렸습니다.', false);
    }).catch(function (error) {
      showFlash((error && error.message) || '되돌리지 못했습니다. 다시 시도해 주세요.', true);
    }).then(function () {
      setStatusButtonsDisabled(false);
    });
  });
  $('clear').addEventListener('click', function () { clearFilters(''); render(); });
  $('tab-list').addEventListener('click', function () { showTab('list'); });
  $('tab-add').addEventListener('click', function () { showTab('add'); });

  $('fee').addEventListener('input', function () {
    var digits = this.value.replace(/\D/g, '').replace(/^0+/, '').slice(0, 9);
    this.value = digits ? Number(digits).toLocaleString('ko-KR') : '';
  });

  fillRegions($('f-region'));
  fillRegions($('region'));
  $('region').addEventListener('change', updatePlaceList);

  for (var n = 0; n <= 11; n++) {
    var option = el('option', '', n + '명');
    option.value = String(n);
    $('players').appendChild(option);
  }

  $('demo-notice').hidden = !!isSheetApp;
  call('listGames').then(function (rows) {
    if (adminCode) return;
    games = rows;
    loaded = true;
    updatePlaceList();
    render();
  }).catch(function (error) {
    loadError = (error && error.message) || '새로고침해 다시 시도해 주세요.';
    render();
  });
})();
</script>

</body>
</html>
