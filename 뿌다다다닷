<!DOCTYPE html>
<html lang="ko">
<head><base target="_top"></head>
<body>
<title>조기축구 경기 찾기</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Black+Han+Sans&family=IBM+Plex+Sans+KR:wght@400;500;600&display=swap">
<style>
/* Layout: floodlit night match. A stadium hero with a pitch in perspective, then TV-broadcast fixture graphics. Referee cards mark status: yellow = 매칭중, red = 매칭완료. Single dark world on purpose. */
:root {
  color-scheme: dark;
  --night: #050920;
  --panel: #101640;
  --panel-2: #182058;
  --line: #2c3578;
  --fg: #f4f6ff;
  --muted: #aab2dc;
  --yellow: #ffe600;
  --on-yellow: #0b0f2c;
  --red: #ff2d46;
  --grass: #0fae55;
  --grass-deep: #07693a;
  --danger-bg: #4a1022;
  --danger-fg: #ffb3bd;
  --display: "Black Han Sans", "Noto Sans CJK KR", "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
  --digits: "Anton", Impact, "Arial Narrow", "Noto Sans CJK KR", sans-serif;
  --body: "IBM Plex Sans KR", "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { background: var(--night); }
body {
  margin: 0;
  background: var(--night);
  color: var(--fg);
  font: 400 1rem/1.55 var(--body);
  word-break: keep-all;
  overflow-wrap: anywhere;
  font-synthesis-weight: none;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--night); }
button, input, select { font: inherit; color: inherit; }
button, summary { cursor: pointer; }
:focus-visible { outline: 3px solid var(--yellow); outline-offset: 2px; }
.wrap {
  max-width: 76rem;
  margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}

/* Stadium hero */
.stadium { position: relative; overflow: hidden; isolation: isolate; background: linear-gradient(#02041a, #0a1140 55%, #07693a); }
.plane {
  position: absolute;
  z-index: -2;
  left: -45%;
  right: -45%;
  bottom: -4%;
  height: 92%;
  transform: perspective(34rem) rotateX(58deg);
  transform-origin: 50% 100%;
  background: repeating-linear-gradient(90deg, var(--grass) 0 7%, var(--grass-deep) 7% 14%);
}
.plane svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.plane svg * { fill: none; stroke: rgba(255, 255, 255, .85); stroke-width: 4; vector-effect: non-scaling-stroke; }
.beams { position: absolute; inset: 0; z-index: -1; pointer-events: none; mix-blend-mode: screen; }
.beam {
  position: absolute;
  top: -8%;
  width: 62%;
  height: 130%;
  background: linear-gradient(rgba(214, 228, 255, .34), rgba(214, 228, 255, 0) 72%);
  filter: blur(22px);
}
.beam.left { left: -8%; clip-path: polygon(0 0, 16% 0, 100% 100%, 22% 100%); }
.beam.right { right: -8%; clip-path: polygon(84% 0, 100% 0, 78% 100%, 0 100%); }
.lamps {
  position: absolute;
  top: .6rem;
  width: 5.5rem;
  height: 1.5rem;
  background: radial-gradient(circle, #ffffff 0 .22rem, rgba(255, 255, 255, 0) .34rem) 0 0 / 1.1rem .75rem;
  filter: drop-shadow(0 0 .6rem #dfe9ff) drop-shadow(0 0 1.4rem #9db8ff);
}
.lamps.left { left: .6rem; }
.lamps.right { right: .6rem; }
.hero { position: relative; display: grid; gap: .75rem; padding-block: 2.75rem 1.25rem; }
.hero > * { min-width: 0; }
.kicker { margin: 0; color: var(--yellow); font-weight: 700; letter-spacing: .02em; text-shadow: 0 1px 8px #000; }
h1 {
  margin: 0;
  font: 900 clamp(4.25rem, 21vw, 9rem)/1.05 var(--display);
  letter-spacing: -.02em;
  white-space: nowrap;
  transform: skewX(-9deg);
  transform-origin: 0 100%;
  text-shadow: 0 .05em 0 #0b0f2c, 0 .4rem 2rem rgba(0, 0, 0, .75), 0 0 3rem rgba(170, 195, 255, .5);
}
.sub { margin: 0; max-width: 32rem; font-size: 1.0625rem; font-weight: 600; text-shadow: 0 1px 8px #000; }
.board-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: min(100%, 34rem);
  margin-top: .35rem;
  background: rgba(5, 9, 32, .86);
  border-top: 3px solid var(--yellow);
}
.cell { display: flex; align-items: baseline; justify-content: center; flex-wrap: wrap; gap: 0 .4rem; padding: .45rem .3rem; }
.cell + .cell { border-left: 1px solid var(--line); }
.cell b { font: 400 2.25rem/1.05 var(--digits); font-variant-numeric: tabular-nums; }
.cell span { color: var(--muted); font-size: .75rem; font-weight: 600; }
.cell.c-open b { color: var(--yellow); }
.cell.c-done b { color: var(--red); }
@keyframes lightsOn {
  0% { opacity: .05; } 18% { opacity: .9; } 26% { opacity: .15; } 44% { opacity: 1; } 52% { opacity: .35; } 100% { opacity: 1; }
}
@keyframes slam {
  0% { opacity: 0; transform: skewX(-9deg) translateX(-1.5rem) scale(1.08); }
  100% { opacity: 1; transform: skewX(-9deg); }
}
.beams, .lamps { animation: lightsOn .9s linear both; }
h1 { animation: slam .4s .45s cubic-bezier(.2, .9, .25, 1) both; }

/* Sticky nav */
.nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--night); border-bottom: 1px solid var(--line); }
.tabs { display: flex; gap: .35rem; padding-block: .5rem; }
.tab {
  flex: 1 1 0;
  max-width: 11rem;
  min-height: 3rem;
  border: 0;
  background: var(--panel);
  color: var(--fg);
  font: 900 1.125rem/1 var(--display);
  clip-path: polygon(.7rem 0, 100% 0, calc(100% - .7rem) 100%, 0 100%);
}
.tab[aria-selected="true"] { background: var(--yellow); color: var(--on-yellow); }
.tab:focus-visible { outline-offset: -5px; outline-color: var(--red); }

/* Page */
main.wrap { display: grid; gap: 1rem; padding-block: 1rem 4rem; }
main.wrap > * { min-width: 0; }
.notice { margin: 0; padding: .55rem .8rem; border-left: 3px solid var(--yellow); background: var(--panel); color: var(--muted); font-size: .875rem; }
.view { display: grid; gap: 1rem; }
.view > * { min-width: 0; }
.board { display: grid; gap: .85rem; min-width: 0; }
.board > * { min-width: 0; }
#view-add { max-width: 44rem; width: 100%; margin: 0 auto; }

/* Filters */
.filters { display: grid; gap: .6rem; }
.filters > * { min-width: 0; }
.date-strip { display: flex; gap: .35rem; overflow-x: auto; padding-bottom: .35rem; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
.day-btn {
  flex: 0 0 3.5rem;
  display: grid;
  justify-items: center;
  align-content: center;
  min-height: 4.5rem;
  padding: .3rem .1rem;
  border: 1px solid var(--line);
  background: var(--panel);
  color: var(--fg);
}
.day-btn.all { flex-basis: 4rem; font: 900 1.0625rem/1 var(--display); }
.day-week { color: var(--muted); font-size: .75rem; font-weight: 600; }
.day-num { font: 400 1.625rem/1.15 var(--digits); font-variant-numeric: tabular-nums; }
.day-count { color: var(--yellow); font-size: .75rem; font-weight: 700; }
.day-btn.none .day-num, .day-btn.none .day-week { opacity: .42; }
.day-btn.weekend .day-week { color: var(--yellow); }
.day-btn[aria-pressed="true"], .day-btn[aria-pressed="true"] .day-week, .day-btn[aria-pressed="true"] .day-count { background: var(--yellow); border-color: var(--yellow); color: var(--on-yellow); }
.filter-row { display: grid; gap: .5rem; }
.filter-row > * { min-width: 0; }
.filter-row .field label, .filter-row .legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
.more-filters .field label { position: static; width: auto; height: auto; clip-path: none; }
.filter-row .seg { margin-top: 0; }
.field { display: grid; gap: .3rem; min-width: 0; }
.field label, .legend { font-size: .875rem; font-weight: 600; color: var(--muted); }
.opt { font-weight: 400; }
.field input, .field select {
  width: 100%;
  min-width: 0;
  min-height: 3.25rem;
  padding: .4rem .75rem;
  border: 1px solid var(--line);
  border-radius: 0;
  background: var(--panel);
  color: var(--fg);
}
.field input:focus, .field select:focus { border-color: var(--yellow); }
.hint { margin: 0; color: var(--muted); font-size: .8125rem; }
fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
legend { padding: 0; }
.times { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
.three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
.seg { display: flex; gap: .3rem; margin-top: .3rem; }
.seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.seg label {
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 3.25rem;
  padding: .2rem .4rem;
  background: var(--panel);
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
}
.seg input:checked + label { background: var(--yellow); color: var(--on-yellow); }
.seg input:focus-visible + label { outline: 3px solid var(--yellow); outline-offset: 2px; }
.more-filters summary { min-height: 2.75rem; padding: .55rem 0; color: var(--yellow); font-weight: 700; }
.more-filters .times { padding-top: .25rem; }

.result-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; }
.count { margin: 0; font: 900 clamp(1.5rem, 6vw, 2.25rem)/1.15 var(--display); font-variant-numeric: tabular-nums; }
.head-actions { display: flex; flex-wrap: wrap; gap: .35rem; }
.ghost { min-height: 2.75rem; padding: .3rem .85rem; border: 1px solid var(--line); background: var(--panel); color: var(--fg); font-size: .875rem; font-weight: 600; }
.ghost:hover { border-color: var(--yellow); }
.admin-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; font-weight: 700; }
.admin-bar span { min-width: 0; }
.flash { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; padding: .55rem .8rem; background: var(--yellow); color: var(--on-yellow); font-weight: 700; }
.flash span { min-width: 0; }
.flash .ghost { background: var(--on-yellow); color: var(--fg); border-color: var(--on-yellow); }

/* Fixture graphics */
.games { display: grid; gap: .7rem; margin: 0; padding: 0; list-style: none; }
.game {
  display: grid;
  min-width: 0;
  background: linear-gradient(100deg, var(--panel-2), var(--panel) 60%);
  border-bottom: 3px solid var(--line);
  transition: transform .14s ease, border-color .14s ease;
}
.game:hover { transform: translateY(-3px); border-color: var(--yellow); }
.game.new { border-color: var(--yellow); box-shadow: 0 0 1.5rem rgba(255, 230, 0, .3); }
.game-main { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr) auto; width: 100%; padding: 0; border: 0; background: transparent; color: var(--fg); text-align: left; }
.stub {
  display: grid;
  align-content: center;
  justify-items: center;
  padding: .75rem 1rem .75rem .25rem;
  background: var(--grass-deep);
  clip-path: polygon(0 0, 100% 0, calc(100% - .85rem) 100%, 0 100%);
}
.is-first .stub { background: var(--yellow); color: var(--on-yellow); }
.is-done .stub, .is-past .stub { background: #39406c; color: var(--fg); }
.stub-month { font-size: .75rem; font-weight: 700; }
.stub-day { font: 400 2.75rem/1.05 var(--digits); font-variant-numeric: tabular-nums; }
.stub-week { font-size: .8125rem; font-weight: 700; }
.ticket { display: grid; align-content: center; gap: .3rem; min-width: 0; padding: .7rem .5rem .6rem .35rem; }
.first-tag { justify-self: start; padding: 0 .4rem; background: var(--yellow); color: var(--on-yellow); font-size: .75rem; font-weight: 800; }
.time { display: inline-block; font: 400 clamp(2rem, 9.5vw, 2.75rem)/1 var(--digits); font-variant-numeric: tabular-nums; transform: skewX(-7deg); transform-origin: 0 100%; }
.time small { color: var(--muted); font-size: .55em; }
.where { display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem .5rem; }
.region { color: var(--yellow); font: 900 1.0625rem/1.3 var(--display); }
.place { font-weight: 600; }
.facts { display: flex; flex-wrap: wrap; align-items: center; gap: .1rem .6rem; color: var(--muted); font-size: .875rem; }
.pill { display: inline-flex; align-items: center; gap: .35rem; font-size: .8125rem; font-weight: 800; white-space: nowrap; }
.pill::before { content: ""; width: .6rem; height: .85rem; border-radius: 1px; background: currentColor; transform: rotate(10deg); }
.pill.open { color: var(--yellow); }
.pill.done { color: #ff8795; }
.pill.done::before { background: var(--red); }
.past-tag { color: var(--muted); font-size: .8125rem; font-weight: 700; }
.more { color: var(--fg); font-size: .875rem; font-weight: 700; text-decoration: underline; text-underline-offset: .2em; }
.rate { display: grid; align-content: center; justify-items: center; min-width: 3.4rem; padding: .5rem .6rem; background: rgba(5, 9, 32, .55); }
.rate b { font: 400 2.75rem/1 var(--digits); }
.rate span { color: var(--muted); font-size: .6875rem; font-weight: 700; }
.level-A b { color: var(--yellow); }

.detail { display: grid; gap: .8rem; padding: 1rem; background: var(--night); border-top: 3px solid var(--yellow); }
.detail h3 { margin: 0; font: 900 1.625rem/1.15 var(--display); transform: skewX(-7deg); transform-origin: 0 100%; }
.detail ol { display: grid; gap: .75rem 1.5rem; margin: 0; padding-left: 1.7rem; }
.detail li::marker { color: var(--yellow); font-weight: 800; font-variant-numeric: tabular-nums; }
.detail-label, .detail-value, .detail-note { display: block; }
.detail-label { color: var(--muted); font-size: .8125rem; }
.detail-value { font-weight: 700; }
.detail-note { color: var(--muted); font-size: .8125rem; }

.status-btn { min-height: 3.25rem; border: 0; border-top: 1px solid var(--line); background: transparent; color: var(--yellow); font-weight: 800; }
.status-btn:hover { background: var(--yellow); color: var(--on-yellow); }
.status-btn:disabled { opacity: .6; cursor: progress; }

.empty { padding: 2.5rem 1rem; background: var(--panel); color: var(--muted); text-align: center; }
.empty strong { display: block; color: var(--fg); font: 900 1.375rem/1.4 var(--display); }

form { display: grid; gap: 1rem; }
#gate, #form { padding: 1.1rem; background: var(--panel-2); }
#gate .field input, #form .field input, #form .field select { background: var(--night); }
.alert { margin: 0; padding: .6rem .8rem; background: var(--danger-bg); color: var(--danger-fg); font-weight: 600; }
.primary {
  min-height: 3.75rem;
  border: 0;
  background: var(--yellow);
  color: var(--on-yellow);
  font: 900 1.375rem/1 var(--display);
  clip-path: polygon(.8rem 0, 100% 0, calc(100% - .8rem) 100%, 0 100%);
}
.primary:focus-visible { outline-offset: -6px; outline-color: var(--red); }
.primary:disabled { opacity: .6; cursor: progress; }

@media (max-width: 30rem) { .three { grid-template-columns: minmax(0, 1fr); } }
@media (min-width: 40rem) {
  .filter-row { grid-template-columns: minmax(0, 16rem) minmax(0, 24rem); align-items: end; }
  .more-filters { grid-column: 1 / -1; }
  .detail ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (min-width: 62rem) {
  .games { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  .game.is-open { grid-column: 1 / -1; }
  .more-filters .times { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 44rem; }
}
@media (prefers-reduced-motion: reduce) {
  .beams, .lamps, h1 { animation: none; }
  .game { transition: none; }
  .game:hover { transform: none; }
}
</style>

<header class="stadium">
  <div class="plane" aria-hidden="true">
    <svg viewBox="0 0 1000 500" preserveAspectRatio="none">
      <rect x="40" y="20" width="920" height="470"/>
      <path d="M500 20V490"/>
      <circle cx="500" cy="255" r="62"/>
      <path d="M40 130H180V380H40"/>
      <path d="M960 130H820V380H960"/>
    </svg>
  </div>
  <div class="beams" aria-hidden="true"><div class="beam left"></div><div class="beam right"></div></div>
  <div class="lamps left" aria-hidden="true"></div>
  <div class="lamps right" aria-hidden="true"></div>
  <div class="wrap hero">
    <p class="kicker">조기축구 경기 찾기</p>
    <h1>한판 붙자</h1>
    <p class="sub">이번 주 상대 팀, 날짜만 누르면 바로 나옵니다.</p>
    <div class="board-panel" aria-label="경기 현황">
      <div class="cell c-open"><b id="sb-open">--</b><span>매칭중</span></div>
      <div class="cell c-done"><b id="sb-done">--</b><span>매칭완료</span></div>
      <div class="cell"><b id="sb-regions">--</b><span>매칭중 지역</span></div>
    </div>
  </div>
</header>
<nav class="nav">
  <div class="wrap">
    <div class="tabs" role="tablist" aria-label="화면">
      <button class="tab" id="tab-list" role="tab" type="button" aria-selected="true" aria-controls="view-list">경기 찾기</button>
      <button class="tab" id="tab-add" role="tab" type="button" aria-selected="false" aria-controls="view-add">경기 올리기</button>
    </div>
  </div>
</nav>

<main class="wrap">
  <p class="notice" id="demo-notice" hidden>미리보기입니다. 보이는 경기는 모두 가상의 예시이고, 입력한 내용은 시트에 저장되지 않으며 새로고침하면 사라집니다. 미리보기용 관리자 코드는 1234(관리자 A)와 5678(관리자 B)입니다.</p>

  <section class="view" id="view-list" role="tabpanel" aria-labelledby="tab-list">
    <div class="filters">
      <div class="date-strip" id="date-strip" role="group" aria-label="날짜 고르기"></div>
      <div class="filter-row">
        <div class="field">
          <label for="f-region">지역</label>
          <select id="f-region">
            <option value="">전체 지역</option>
          </select>
        </div>
        <fieldset>
          <legend class="legend">경기상태</legend>
          <div class="seg">
            <input type="radio" name="f-status" id="fs-open" value="매칭중" checked><label for="fs-open">매칭중</label>
            <input type="radio" name="f-status" id="fs-done" value="매칭완료"><label for="fs-done">매칭완료</label>
            <input type="radio" name="f-status" id="fs-all" value=""><label for="fs-all">전체</label>
          </div>
        </fieldset>
        <details class="more-filters">
          <summary>날짜·시간 직접 고르기</summary>
          <div class="times">
            <div class="field">
              <label for="f-date">날짜</label>
              <input id="f-date" type="date">
            </div>
            <div class="field">
              <label for="f-from">이 시각부터 시작</label>
              <input id="f-from" type="time">
            </div>
            <div class="field">
              <label for="f-to">이 시각까지 종료</label>
              <input id="f-to" type="time">
            </div>
          </div>
        </details>
      </div>
    </div>

    <div class="board">
    <div class="result-head">
      <p class="count" id="count" aria-live="polite">경기를 불러오는 중입니다</p>
      <div class="head-actions">
        <button class="ghost" id="admin-open" type="button">관리자 코드 입력</button>
        <button class="ghost" id="clear" type="button">조건 지우기</button>
      </div>
    </div>
    <div class="flash" id="flash" role="status" hidden>
      <span id="flash-text"></span>
      <button class="ghost" id="undo" type="button">되돌리기</button>
    </div>
    <div class="board" id="results"></div>
    </div>
  </section>

  <section class="view" id="view-add" role="tabpanel" aria-labelledby="tab-add" hidden>
    <form id="gate" novalidate>
      <div class="field">
        <label for="admin-code">관리자 코드</label>
        <input id="admin-code" type="password" autocomplete="off">
        <p class="hint">관리자마다 자기 코드를 씁니다. 경기상태는 내가 올린 경기만 바꿀 수 있습니다.</p>
      </div>
      <p class="alert" id="gate-error" role="alert" hidden></p>
      <button class="primary" id="gate-submit" type="submit">확인</button>
    </form>
    <div class="admin-bar" id="admin-bar" hidden>
      <span id="admin-who"></span>
      <button class="ghost" id="admin-end" type="button">관리자 모드 끝내기</button>
    </div>
    <form id="form" novalidate hidden>
      <div class="field">
        <label for="date">날짜</label>
        <input id="date" name="date" type="date" required>
      </div>
      <div class="times">
        <div class="field">
