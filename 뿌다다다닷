      if (name === 'setGameStatus') {
        var found = demoGames.filter(function (g) { return g.row === arg.row; })[0];
        if (found.owner !== alias) return Promise.reject(new Error('내가 올린 경기만 바꿀 수 있습니다.'));
        found.status = arg.status;
      }
      return Promise.resolve(demoList(alias));
    }
    return new Promise(function (resolve, reject) {
      var runner = google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);
      if (arg === undefined) runner[name](); else runner[name](arg);
    });
