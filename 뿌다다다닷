      if (name === 'verifyAdmin') {
        return DEMO_ADMINS[arg]
          ? Promise.resolve({ alias: DEMO_ADMINS[arg], games: demoList(DEMO_ADMINS[arg]) })
          : Promise.reject(new Error('관리자 코드가 맞지 않습니다.'));
